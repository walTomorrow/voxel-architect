# Server-only — copy to .env.local (never commit .env.local).
# For Wrangler/OpenNext local preview, see .dev.vars.example (non-secret only) and docs/deployment/CLOUDFLARE.md.

# Cloudflare Workers AI (Builder chat at POST /api/builder/chat)
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
CLOUDFLARE_API_TOKEN=your_api_token_with_workers_ai_access

# Multimodal default: text + user reference images
WORKERS_AI_MODEL=@cf/meta/llama-3.2-11b-vision-instruct

# One-time Meta license (if the model returns a license error).
# .env.local is for Next.js only — export vars in your terminal first, or paste IDs into the URL.
#
# PowerShell (from repo root, after setting $accountId and $token from .env.local):
#   curl.exe -X POST "https://api.cloudflare.com/client/v4/accounts/$accountId/ai/run/@cf/meta/llama-3.2-11b-vision-instruct" -H "Authorization: Bearer $token" -H "Content-Type: application/json" -d "{\"prompt\":\"agree\"}"
#
# Git Bash:
#   export CLOUDFLARE_ACCOUNT_ID=your_account_id_here
#   export CLOUDFLARE_API_TOKEN=your_token_here
#   curl -X POST "https://api.cloudflare.com/client/v4/accounts/$CLOUDFLARE_ACCOUNT_ID/ai/run/@cf/meta/llama-3.2-11b-vision-instruct" -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" -H "Content-Type: application/json" -d '{"prompt":"agree"}'
#
# Expected agree response (looks like an error but means success):
#   code 5016, "Thank you for agreeing ... You may now use the model", success:false
# If the path shows accounts/ai/run with no account ID in the URL, CLOUDFLARE_ACCOUNT_ID was empty in the shell.
